# Leído por la CLI de Supabase (supabase/config.toml). Copia a supabase/.env y completa.
# Google OAuth (Google Cloud Console > Credenciales > ID de cliente OAuth).
# URI de redirección autorizada en local: http://127.0.0.1:55321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# GitHub OAuth App (GitHub > Settings > Developer settings > OAuth Apps). Solo para vincular la cuenta.
# Authorization callback URL en local: http://127.0.0.1:55321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
