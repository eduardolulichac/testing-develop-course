# Supabase (en local: `pnpm db:status` muestra URL y claves; API en http://127.0.0.1:55321)
NEXT_PUBLIC_SUPABASE_URL=
# Clave publicable (sb_publishable_...), reemplaza a la antigua "anon key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta (sb_secret_...), reemplaza a "service_role". Solo servidor, nunca en el cliente.
SUPABASE_SECRET_KEY=

# Sitio (en local: http://localhost:3100). Base de los enlaces de auth (correo, OAuth).
NEXT_PUBLIC_SITE_URL=

# Evaluación de retos (docs/EVALUACION_DISENO.md). Solo servidor.
# Secreto maestro (mínimo 32 caracteres) del que se derivan las claves HMAC por alumno y reto.
CHALLENGE_MASTER_SECRET=
# Token de GitHub de solo lectura (fine-grained, sin permisos ni repos privados), caducidad de 1 año.
GITHUB_API_TOKEN=
# `live` consulta la API de GitHub; `fake` acepta cualquier ejecución y se rechaza con NODE_ENV=production.
GITHUB_VERIFY_MODE=live
# Evaluador público (repo y ruta del workflow) y pares `version@sha40` permitidos, separados por coma.
EVALUATOR_REPO=eduardolulichac/qa-course-evaluator
EVALUATOR_WORKFLOW_PATH=.github/workflows/evaluate.yml
EVALUATOR_ALLOWED=

# Correo (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Analítica (PostHog)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
# Solo para scripts/posthog-funnels.mjs (clave personal con insight:write y dashboard:write; caduca pronto)
POSTHOG_PERSONAL_API_KEY=

# QR de aportes (URLs de imagen)
NEXT_PUBLIC_QR_YAPE_URL=
NEXT_PUBLIC_QR_PLIN_URL=
NEXT_PUBLIC_QR_INTERNATIONAL_URL=

# Observabilidad
SENTRY_DSN=

# URL de QA Arena (para enlaces desde lecciones)
NEXT_PUBLIC_ARENA_URL=

# Panel del autor (E6-2): ids de usuario autorizados, separados por coma
AUTHOR_USER_IDS=
