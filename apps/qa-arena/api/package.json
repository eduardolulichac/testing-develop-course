{
  "name": "@arena/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "QA Arena REST API (Fastify + Postgres)",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "openapi": "tsx scripts/generate-openapi.ts && pnpm -w exec prettier --write apps/qa-arena/api/openapi.json",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@arena/scenarios": "workspace:*",
    "@course/scenario-engine": "workspace:*",
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
