# QA Arena API. Names only; real values go in the host's environment, never in git.
DATABASE_URL=
API_PORT=3000
# local | ephemeral | hosted (obligatoria con NODE_ENV=production)
ARENA_DEPLOYMENT=
# shared | per-visitor (obligatoria con NODE_ENV=production; hosted exige per-visitor)
ARENA_SESSION_MODE=
# mínimo 32 caracteres; obligatoria con ARENA_DEPLOYMENT=hosted
ARENA_COOKIE_SECRET=
ARENA_SESSION_TTL_MINUTES=240
ARENA_MAX_SESSIONS=500
ARENA_MAX_SESSIONS_PER_IP=3
ARENA_RATE_LIMIT_PER_MIN=120
# número de saltos de proxy de confianza (0 = ninguno); NUNCA "true"
ARENA_TRUST_PROXY=0
ARENA_DEFAULT_SCENARIO=
ASSISTANT_API_KEY=
ASSISTANT_MODEL=
