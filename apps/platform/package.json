{
  "name": "@course/platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "sync:content": "tsx scripts/sync-content.ts",
    "recalc:levels": "tsx scripts/recalc-levels.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:e2e": "playwright test",
    "db:start": "supabase start --workdir ../..",
    "db:stop": "supabase stop --workdir ../..",
    "db:reset": "supabase db reset --workdir ../..",
    "db:status": "supabase status --workdir ../.."
  },
  "dependencies": {
    "@course/shared": "workspace:*",
    "@mdx-js/mdx": "3.1.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "next": "16.4.5",
    "next-themes": "0.4.6",
    "posthog-js": "1.447.3",
    "posthog-node": "5.63.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/mdx": "2.0.14",
    "@types/node": "^24.0.0",
    "@types/pg": "^8",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.5",
    "pg": "8.23.1",
    "supabase": "3.0.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
