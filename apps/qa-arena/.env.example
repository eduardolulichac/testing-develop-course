# QA Arena vive aislada de la plataforma: no reutilizar credenciales ni bases de la plataforma.
# Solo nombres y valores de desarrollo local; los valores reales de un host se ponen fuera del repo.

# Base de datos propia de la Arena (con docker compose se arma sola desde POSTGRES_*)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# Puertos publicados en el host (compose usa 18080 y 18081 por defecto)
API_PORT=
WEB_PORT=

# Sesiones: "shared" (una sola sesion; evaluacion en el runner) o "per-visitor" (Arena alojada)
ARENA_SESSION_MODE=
ARENA_SESSION_TTL_MINUTES=
ARENA_MAX_SESSIONS=

# Asistente con IA (modulo 4.7). Vacio = stub determinista, sin servicios externos.
ASSISTANT_API_KEY=
ASSISTANT_MODEL=
ASSISTANT_API_URL=
